# Replace domain, certificate paths and project paths before enabling.
server {
    listen 80;
    server_name your-domain.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;
    root /srv/uniconnect/frontend/dist;
    client_max_body_size 24m;

    location /static/ { alias /srv/uniconnect/backend/staticfiles/; }
    location /media/ {
        alias /srv/uniconnect/backend/media/;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ ^/(api|admin)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # Overwrite user-provided forwarding headers for this single proxy hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 240s;
    }
    location / { try_files $uri $uri/ /index.html; }
}
