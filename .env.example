# Copy to .env for local use; process environment takes precedence.
DB_ENGINE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=uniconnect_ai
MYSQL_USER=uniconnect_app
MYSQL_PASSWORD=
# Optional hosting settings:
DB_CONN_MAX_AGE=0
# MYSQL_SSL_CA=/path/to/ca.pem
# Render + TiDB: DB_ENGINE=tidb, MYSQL_PORT=4000, DJANGO_SETTINGS_MODULE=config.cloud
# Set cloud secrets in Render Environment, never commit .env or connection passwords.
# For an isolated SQLite development/test run: DB_ENGINE=sqlite
# SQLITE_PATH=backend/db.sqlite3
CHAT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_OUTPUT_TOKENS=1600
# To use Gemini, set CHAT_PROVIDER=gemini and fill GEMINI_API_KEY on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BUDGET=8
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Production workers: DJANGO_SETTINGS_MODULE=config.production
# Only enable behind a trusted reverse proxy that overwrites proxy headers:
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
REQUEST_LIMITS_ENABLED=true
LOGIN_REQUESTS_PER_MINUTE=20
CHAT_REQUESTS_PER_MINUTE=6
CHAT_IP_REQUESTS_PER_MINUTE=30
# Password reset is disabled until SMTP is configured. No credentials in source.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=UniConnect AI <no-reply@your-domain.example>
